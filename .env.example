# Kod sezone u EuroLeague API-ju: "E" + godina u kojoj sezona počinje (2026-27 -> E2026)
EUROLEAGUE_SEASON=E2026

# Neon Postgres. Samo imena; prave vrednosti su u .env.local i na Vercel-u.
# Direktna konekcija (host bez "-pooler"): drizzle-kit migracije.
DATABASE_URL=
# Pooled konekcija (host sa "-pooler"): aplikacija i sync.
DATABASE_URL_POOLED=

# Tajna za /api/cron/sync (nasumičan string, bar 16 karaktera).
# Vercel Cron je šalje kao "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
